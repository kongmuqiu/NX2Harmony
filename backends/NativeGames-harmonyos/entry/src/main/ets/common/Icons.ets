// Generated by tools/ui_icons.py: the shell's icons by name (ArkTS takes $r only with a literal name).
export function icon(name: string): Resource {
  switch (name) {
    case 'play': return $r('app.media.ic_play');
    case 'settings': return $r('app.media.ic_settings');
    case 'save': return $r('app.media.ic_save');
    case 'info': return $r('app.media.ic_info');
    case 'back': return $r('app.media.ic_back');
    case 'forward': return $r('app.media.ic_forward');
    case 'close': return $r('app.media.ic_close');
    case 'check': return $r('app.media.ic_check');
    case 'warning': return $r('app.media.ic_warning');
    case 'export': return $r('app.media.ic_export');
    case 'import': return $r('app.media.ic_import');
    case 'restore': return $r('app.media.ic_restore');
    case 'controller': return $r('app.media.ic_controller');
    case 'touch': return $r('app.media.ic_touch');
    case 'look': return $r('app.media.ic_look');
    case 'sticks': return $r('app.media.ic_sticks');
    case 'gauge': return $r('app.media.ic_gauge');
    case 'layers': return $r('app.media.ic_layers');
    case 'sparkle': return $r('app.media.ic_sparkle');
    case 'display': return $r('app.media.ic_display');
    case 'more': return $r('app.media.ic_more');
    case 'menu': return $r('app.media.ic_menu');
    case 'home': return $r('app.media.ic_home');
    case 'data': return $r('app.media.ic_data');
    case 'shader': return $r('app.media.ic_shader');
    case 'clock': return $r('app.media.ic_clock');
    case 'slot': return $r('app.media.ic_slot');
    case 'power': return $r('app.media.ic_power');
    case 'plus': return $r('app.media.ic_plus');
    case 'minus': return $r('app.media.ic_minus');
    case 'dpad_up': return $r('app.media.ic_dpad_up');
    case 'dpad_down': return $r('app.media.ic_dpad_down');
    case 'dpad_left': return $r('app.media.ic_dpad_left');
    case 'dpad_right': return $r('app.media.ic_dpad_right');
    case 'eye': return $r('app.media.ic_eye');
    case 'eye_off': return $r('app.media.ic_eye_off');
    case 'language': return $r('app.media.ic_language');
    case 'volume': return $r('app.media.ic_volume');
    case 'shield': return $r('app.media.ic_shield');
    case 'pouch': return $r('app.media.ic_pouch');
    case 'note': return $r('app.media.ic_note');
    case 'sword': return $r('app.media.ic_sword');
    case 'crouch': return $r('app.media.ic_crouch');
    case 'scope': return $r('app.media.ic_scope');
    case 'ability': return $r('app.media.ic_ability');
    case 'throw': return $r('app.media.ic_throw');
    case 'bow': return $r('app.media.ic_bow');
    case 'jump': return $r('app.media.ic_jump');
    case 'attack': return $r('app.media.ic_attack');
    case 'target': return $r('app.media.ic_target');
    case 'dash': return $r('app.media.ic_dash');
    case 'undo': return $r('app.media.ic_undo');
    case 'map': return $r('app.media.ic_map');
    case 'blocks': return $r('app.media.ic_blocks');
    case 'swap': return $r('app.media.ic_swap');
    default: return $r('app.media.ic_more');
  }
}

